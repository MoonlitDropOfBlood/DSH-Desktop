{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "1.4.2",
  "description": "Desktop wrapper for DeepSeek Harness: embeds the DSH web UI with window controls, tray, and update management. DSH core is NOT bundled — it is installed via npm on the target machine.",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-tray-icon.js",
    "fetch:market": "node scripts/fetch-market-plugin.js",
    "fetch:pnpm": "node scripts/fetch-pnpm.js",
    "fetch:node": "node scripts/fetch-node.js",
    "pack": "npm run fetch:market && npm run fetch:pnpm && npm run fetch:node && electron-builder --dir",
    "dist": "npm run fetch:market && npm run fetch:pnpm && npm run fetch:node && electron-builder",
    "dist:win": "npm run fetch:market && npm run fetch:pnpm && npm run fetch:node && electron-builder --win nsis",
    "dist:mac": "npm run fetch:market && npm run fetch:pnpm && npm run fetch:node && electron-builder --mac",
    "dist:linux": "npm run fetch:market && npm run fetch:pnpm && npm run fetch:node && electron-builder --linux",
    "dist:portable": "npm run fetch:market && npm run fetch:pnpm && npm run fetch:node && electron-builder --win portable"
  },
  "build": {
    "appId": "ai.deepseek.dsh.desktop",
    "productName": "DeepSeek Harness Desktop",
    "afterPack": "scripts/mac-sign.js",
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "dsh-desktop-plugin/**",
      "build/tray-icon.png",
      "build/tray-iconTemplate.png",
      "build/tray-iconTemplate@2x.png",
      "build/market-plugin/**"
    ],
    "extraResources": [
      {
        "from": "build/pnpm/node_modules/pnpm",
        "to": "pnpm",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/node",
        "to": "node"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon-512.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon-512.png",
      "synopsis": "DeepSeek Harness desktop wrapper",
      "maintainer": "duke <wwhbygx@sina.com>"
    }
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.4.2",
    "electron": "^43.4.1",
    "electron-builder": "^25.1.8"
  }
}
